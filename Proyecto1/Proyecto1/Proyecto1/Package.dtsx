    <DTS:Executable
      DTS:refId="Package\Load Dim_Tiempo"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FE1B692F-DB34-4BF8-80F8-FD9386A2552B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Dim_Tiempo"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2677F801-4C5C-4D8A-B299-A511B2562CBD}"
          SQLTask:SqlStatementSource="-- Extraer fechas VÁLIDAS de ventas&#xA;MERGE Dim_Tiempo AS target&#xA;USING (&#xA;    SELECT DISTINCT TRY_CONVERT(DATE, LTRIM(RTRIM(Fecha)), 103) AS Fecha &#xA;    FROM tmp_Ventas &#xA;    WHERE TRY_CONVERT(DATE, LTRIM(RTRIM(Fecha)), 103) IS NOT NULL&#xA;) AS source&#xA;ON target.Fecha = source.Fecha&#xA;WHEN NOT MATCHED THEN&#xA;    INSERT (Fecha, Dia, Mes, Anio)&#xA;    VALUES (source.Fecha, DAY(source.Fecha), MONTH(source.Fecha), YEAR(source.Fecha));&#xA;&#xA;-- Extraer fechas VÁLIDAS de compras&#xA;MERGE Dim_Tiempo AS target&#xA;USING (&#xA;    SELECT DISTINCT TRY_CONVERT(DATE, LTRIM(RTRIM(Fecha)), 103) AS Fecha &#xA;    FROM tmp_Compra &#xA;    WHERE TRY_CONVERT(DATE, LTRIM(RTRIM(Fecha)), 103) IS NOT NULL&#xA;) AS source&#xA;ON target.Fecha = source.Fecha&#xA;WHEN NOT MATCHED THEN&#xA;    INSERT (Fecha, Dia, Mes, Anio)&#xA;    VALUES (source.Fecha, DAY(source.Fecha), MONTH(source.Fecha), YEAR(source.Fecha));" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Migrar a Dim_Producto Oficial"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{29EE805B-C105-479A-A36A-E36A7382A39B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Migrar a Dim_Producto Oficial"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2677F801-4C5C-4D8A-B299-A511B2562CBD}"
          SQLTask:SqlStatementSource="WITH Limpieza AS (&#xA;    SELECT &#xA;        TRIM(CodProducto) AS CodProducto,&#xA;        UPPER(TRIM(NombreProducto)) AS NombreProducto,&#xA;        UPPER(TRIM(MarcaProducto)) AS MarcaProducto,&#xA;        CASE WHEN Categoria = 'Ninguna' THEN 'NO CLASIFICADO' ELSE UPPER(TRIM(Categoria)) END AS Categoria,&#xA;        ROW_NUMBER() OVER(PARTITION BY TRIM(CodProducto) ORDER BY NombreProducto DESC) AS Fila&#xA;    FROM tmp_Producto&#xA;)&#xA;INSERT INTO Dim_Producto (CodProducto, NombreProducto, MarcaProducto, Categoria)&#xA;SELECT CodProducto, NombreProducto, MarcaProducto, Categoria&#xA;FROM Limpieza&#xA;WHERE Fila = 1;&#xA;&#xA;TRUNCATE TABLE tmp_Producto;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Migrar a Hechos y Limpiar"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5B1C2A05-A2EB-411A-90B2-2A1D1F3D6A6D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Migrar a Hechos y Limpiar"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2677F801-4C5C-4D8A-B299-A511B2562CBD}"
          SQLTask:SqlStatementSource="-- 1. Llenar Fact_Ventas&#xA;INSERT INTO Fact_Ventas (Fecha, CodCliente, CodVendedor, CodProducto, CodSucursal, Unidades, PrecioUnitario)&#xA;SELECT &#xA;    TRY_CONVERT(DATE, REPLACE(UPPER(TRIM(v.Fecha)), 'Z', '2'), 103),&#xA;    v.CodCliente, v.CodVendedor, v.CodProducto, v.CodSucursal, v.Unidades, v.PrecioUnitario&#xA;FROM tmp_Ventas v&#xA;WHERE TRY_CONVERT(DATE, REPLACE(UPPER(TRIM(v.Fecha)), 'Z', '2'), 103) IN (SELECT Fecha FROM Dim_Tiempo)&#xA;AND v.CodCliente IN (SELECT CodCliente FROM Dim_Cliente)&#xA;AND v.CodVendedor IN (SELECT CodVendedor FROM Dim_Vendedor)&#xA;AND v.CodProducto IN (SELECT CodProducto FROM Dim_Producto)&#xA;AND v.CodSucursal IN (SELECT CodSucursal FROM Dim_Sucursal);&#xA;&#xA;-- 2. Llenar Fact_Compras&#xA;INSERT INTO Fact_Compras (Fecha, CodProveedor, CodProducto, CodSucursal, Unidades, CostoUnitario)&#xA;SELECT &#xA;    TRY_CONVERT(DATE, REPLACE(UPPER(TRIM(c.Fecha)), 'Z', '2'), 103),&#xA;    c.CodProveedor, c.CodProducto, c.CodSucursal, c.Unidades, c.CostoUnitario&#xA;FROM tmp_Compra c&#xA;WHERE TRY_CONVERT(DATE, REPLACE(UPPER(TRIM(c.Fecha)), 'Z', '2'), 103) IN (SELECT Fecha FROM Dim_Tiempo)&#xA;AND c.CodProveedor IN (SELECT CodProveedor FROM Dim_Proveedor)&#xA;AND c.CodProducto IN (SELECT CodProducto FROM Dim_Producto)&#xA;AND c.CodSucursal IN (SELECT CodSucursal FROM Dim_Sucursal);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
